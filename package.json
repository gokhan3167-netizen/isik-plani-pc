{
  "name": "isik-plani-masaustu",
  "version": "4.8.0",
  "private": true,
  "description": "Işık Planı – sahne ışık planı ve rider çizimi (Windows / Mac)",
  "author": "Işık Planı",
  "main": "main.js",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "start": "npm run vendor && electron .",
    "dist:win": "npm run vendor && npm run fixtures && electron-builder --win",
    "dist:mac": "npm run vendor && npm run fixtures && electron-builder --mac",
    "dist:linux": "npm run vendor && npm run fixtures && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "@fontsource/barlow": "^5.0.0",
    "@fontsource/barlow-condensed": "^5.0.0",
    "jspdf": "2.5.1",
    "jszip": "3.10.1",
    "three": "0.128.0"
  },
  "build": {
    "appId": "com.isikplani.desktop",
    "productName": "Isik Plani",
    "artifactName": "isik-plani-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "www/**/*"
    ],
    "win": {
      "target": "nsis",
      "executableName": "IsikPlani"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Işık Planı",
      "uninstallDisplayName": "Işık Planı",
      "artifactName": "Isik-Plani-Kurulum-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleDisplayName": "Işık Planı"
      },
      "artifactName": "Isik-Plani-${version}-Mac.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "executableName": "isik-plani"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gokhan3167-netizen",
        "repo": "isik-plani-pc",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gokhan3167-netizen/isik-plani-pc.git"
  }
}
